<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!--
        A standing guarantee rather than a fix for one dependency.

        These arrived with firebase-analytics, which declared both the legacy
        Play Services advertising-ID permission and its Privacy Sandbox
        successor for ad-ID-linked features this app never used. Firebase is
        gone, so today these remove nothing — and that is the point of leaving
        them: whatever a future dependency declares, no advertising-ID
        permission reaches the shipped manifest, and the data-safety form never
        has to claim an ID this app does not read.
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <!--
        RECORD_AUDIO was declared here and requested on first launch, and nothing
        in the app ever used it: there is no AudioRecord, no MediaRecorder, and
        no microphone path anywhere in the source. The sampler's "record" button
        captures this app's own mixer output — a float buffer already in memory,
        on its way to AudioTrack — which needs no permission at all.

        Removed rather than justified. A microphone prompt on first launch, for a
        capability the app does not have, is the kind of thing that gets an app
        uninstalled before it plays a note; it would also have to be declared on
        the Play data safety form and defended in review, for a feature that
        does not exist.
    -->
    <!--
        Analysis of a large folder runs for minutes. A foreground service is what
        keeps it alive while the app is backgrounded, which is precisely when a
        user leaves it to get on with the job; the notification is how they see
        progress and pause it.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        largeHeap is usually a smell — a request for more room to leak in. Here
        it is the actual requirement: two decks of fully decoded PCM is around
        115 MB for five-minute stereo tracks at 48 kHz, and the default ceiling
        is 256 MB on many devices, which the decoder's own working buffers then
        have to fit inside as well. The library is bounded independently by
        DecodedCache, which is sized from the runtime's heap ceiling, so raising
        the ceiling raises the budget rather than deferring a leak.
    -->
    <application
        android:name=".SirMatchALotApplication"
        android:allowBackup="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.SirMatchALot">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".analysis.AnalysisService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
