<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!--
        The pending crash report can hold a full stack trace, file paths and
        the device model. It is meant to leave the device only when a person
        reads the GitHub issue draft and taps submit — not via Android's
        automatic cloud backup, which runs with nobody watching.
    -->
    <exclude domain="sharedpref" path="crash_reports.xml"/>
</full-backup-content>