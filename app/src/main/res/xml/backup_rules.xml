<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for devices on API 30 and below; API 31+ reads
   data_extraction_rules.xml instead. Keep the two in step.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!--
        The pending crash report can hold a full stack trace, file paths and
        the device model. It is meant to leave the device only when a person
        reads the GitHub issue draft and taps submit — not via Android's
        automatic cloud backup, which runs with nobody watching.
    -->
    <exclude domain="sharedpref" path="crash_reports.xml"/>
    <!--
        The device's long-term identity: its private key is what proves to a
        paired device that this is the phone it paired with. A copy restored
        onto another phone would let that phone impersonate this one, so it
        never leaves the device by backup or transfer.
    -->
    <exclude domain="sharedpref" path="device_identity.xml"/>
    <!--
        Local copies of imported audio and the waveform/energy caches derived
        from it. Large, rebuildable from the originals, and the copies are the
        user's music files — none of it belongs in a cloud backup.
    -->
    <exclude domain="file" path="audio/"/>
    <exclude domain="file" path="peaks/"/>
    <exclude domain="file" path="energy/"/>
</full-backup-content>