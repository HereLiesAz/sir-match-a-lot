<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for API 31+; backup_rules.xml covers older
   devices. Keep the two in step.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!--
        The pending crash report can hold a full stack trace, file paths and
        the device model. It is meant to leave the device only when a person
        reads the GitHub issue draft and taps submit — not via cloud backup or
        device-to-device transfer, both of which run with nobody watching.

        device_identity.xml holds this device's private identity key; a copy on
        another phone could impersonate this one to every paired device.
        audio/, peaks/ and energy/ are local copies of the user's music and
        caches derived from them: large, rebuildable, and not backup material.
    -->
    <cloud-backup>
        <exclude domain="sharedpref" path="crash_reports.xml"/>
        <exclude domain="sharedpref" path="device_identity.xml"/>
        <exclude domain="file" path="audio/"/>
        <exclude domain="file" path="peaks/"/>
        <exclude domain="file" path="energy/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="crash_reports.xml"/>
        <exclude domain="sharedpref" path="device_identity.xml"/>
        <exclude domain="file" path="audio/"/>
        <exclude domain="file" path="peaks/"/>
        <exclude domain="file" path="energy/"/>
    </device-transfer>
</data-extraction-rules>